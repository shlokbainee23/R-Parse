# ==============================================================================
# R-PARSE — Environment Configuration Example
# ==============================================================================

# Listening port for the unified web service (Landing Page, Studio & API)
PORT=8080

# Network interface binding (0.0.0.0 for public/container ingress, 127.0.0.1 for local-only)
HOST=0.0.0.0

# Optional Rust logging level (error, warn, info, debug, trace)
RUST_LOG=info
